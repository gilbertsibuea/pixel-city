/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "pixel-city",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-01",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	/**
	 * Local/dev KV. Replace `id` with a real namespace before production deploy:
	 *   npx wrangler kv namespace create CITY_CACHE
	 */
	"kv_namespaces": [
		{
			"binding": "CITY_CACHE",
			"id": "a285cc88443e4bb4a67d74c15c242d18",
			"preview_id": "00000000000000000000000000000000"
		}
	]
	/**
	 * Secrets (set via `wrangler secret put GITHUB_TOKEN` or `.dev.vars` locally):
	 * - GITHUB_TOKEN: fine-grained PAT for public GitHub GraphQL reads
	 */
}